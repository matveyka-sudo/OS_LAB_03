{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (system compiler)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG"
      }
    },
    {
      "name": "apple-clang",
      "displayName": "Apple Clang Release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/cmake-build-clang",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "cacheVariables": {"CMAKE_C_COMPILER": "/usr/bin/clang"}
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "apple-clang", "configurePreset": "apple-clang"}
  ]
}
